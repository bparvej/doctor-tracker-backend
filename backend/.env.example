PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
# Render example: mongodb+srv://<username>:<password>@<cluster-host>/doctor_tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:3000
# Public base origin including /api, used as the Swagger server URL
API_URL=http://localhost:5000/api
SEED_ON_START=true
SEED_ADMIN_NAME=Demo Administrator
SEED_ADMIN_EMAIL=admin@doctortracker.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_VIEWER_NAME=Demo Viewer
SEED_VIEWER_EMAIL=viewer@doctortracker.local
SEED_VIEWER_PASSWORD=ViewMe123!
